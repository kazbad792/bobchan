# cp config.example.env config.env して編集してください

# Obsidian Vault のパス（必須）
OBSIDIAN_VAULT="$HOME/Documents/ObsidianVault"

# Vault 内の保存フォルダ
NEWS_FOLDER="Finance News"

# 何時間前までの記事を対象にするか
LOOKBACK_HOURS=24

# 要約に使うコマンド: claude（Claude Code CLI）/ none（見出し一覧のみ）
SUMMARIZER=claude

# claude コマンドのパス（cron から実行すると PATH が通らないことがあるので絶対パス推奨）
CLAUDE_BIN="claude"
